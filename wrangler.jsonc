{
  // Configuracion de Cloudflare Workers para la landing.
  //
  // POR QUE NO EXISTIA Y POR QUE HIZO FALTA
  //
  // El proyecto esta configurado para desplegar con `npx wrangler versions
  // upload`, pero el repositorio no tenia ningun archivo de configuracion. Sin
  // el, wrangler arranca, no sabe que subir, y falla con "Missing entry-point
  // to Worker script or to assets directory".
  //
  // Eso fallaba en CUALQUIER rama, incluida main. No se noto porque el ultimo
  // cambio de la landing fue el 25 de abril: cuatro meses sin empujar nada, o
  // sea cuatro meses sin ejercitar la tuberia. La consecuencia real era que
  // ningun cambio de la landing se podia publicar desde git.
  //
  // "name" TIENE que coincidir con el Worker que ya sirve rapiditos.app. Si no
  // coincidiera, wrangler no actualizaria ese: crearia uno nuevo, el sitio
  // seguiria igual y quedaria un Worker huerfano.
  "name": "rapiditos-landing",

  "compatibility_date": "2026-08-09",

  // El Worker atiende SOLO lo que no es un archivo de este repositorio.
  //
  // Cloudflare mira primero los assets: si la direccion pedida corresponde a
  // un archivo que existe aca, lo sirve y el Worker NI SE EJECUTA. O sea que
  // la landing sigue saliendo igual que antes de que este archivo existiera,
  // y un error en worker.js solo puede afectar direcciones que hoy dan 404.
  //
  // Lo que atiende: /r/<slug> (la carta del cliente) y /panel/ (el panel del
  // restaurante), reenviandolos al backend. Ver worker.js.
  "main": "worker.js",

  // Los archivos del sitio viven en la raiz; lo que NO se sube esta en
  // .assetsignore. El "binding" es como worker.js les pide un archivo.
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  // Donde vive el backend. VACIA a proposito.
  //
  // Mientras este vacia, /r/* y /panel/* se comportan igual que hoy: 404. Eso
  // permite que todo esto viva en main antes de que el backend exista, sin
  // cambiarle nada al sitio.
  //
  // Se enciende poniendo el valor en Cloudflare (Worker > Settings >
  // Variables) o cambiandolo aca, con la URL completa y sin barra final:
  //
  //     "BACKEND_URL": "https://api.rapiditos.app"
  //
  // No es un secreto: es una direccion publica.
  "vars": {
    "BACKEND_URL": ""
  }
}
